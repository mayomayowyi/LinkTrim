{
  "manifest_version": 3,
  "name": "LinkTrim",
  "version": "0.0.2",
  "description": "不要な情報を除いたURLをコピー。X・YouTube・Amazon・Wikipediaに対応。",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LinkTrim：単体URLをコピー",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://www.x.com/*",
        "*://twitter.com/*",
        "*://www.twitter.com/*",
        "*://mobile.twitter.com/*",
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://amazon.co.jp/*",
        "*://www.amazon.co.jp/*",
        "*://m.amazon.co.jp/*",
        "*://smile.amazon.co.jp/*",
        "*://*.wikipedia.org/*"
      ],
      "js": [
        "card-links.js",
        "inline-buttons.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
